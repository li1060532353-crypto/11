{
  "name": "@namdw/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "pnpm prisma:generate && nest build",
    "start": "node dist/main.js",
    "typecheck": "pnpm prisma:generate && tsc -p tsconfig.json --noEmit",
    "test": "pnpm prisma:generate && jest --config jest.config.cjs --runInBand",
    "test:e2e": "pnpm prisma:generate && jest --config test/jest-e2e.config.cjs --runInBand",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@namdw/shared": "workspace:*",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@prisma/client": "^6.19.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.28",
    "@types/jest": "29.5.14",
    "@types/node": "24.10.1",
    "@types/supertest": "7.2.0",
    "jest": "29.7.0",
    "prisma": "^6.19.3",
    "supertest": "7.2.2",
    "ts-jest": "29.4.11",
    "tsx": "^4.23.1"
  }
}
