{
  "name": "knowledge-base-local",
  "pages_build_output_dir": "./apps/web/dist",
  "compatibility_date": "2026-07-18",
  "d1_databases": [{ "binding": "DB", "database_name": "knowledge-base-local", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "./migrations" }],
  "r2_buckets": [{ "binding": "KB_ASSETS", "bucket_name": "knowledge-base-assets-local" }]
}
